#!/usr/bin/env python3
import os
import csv
from pathlib import Path
from datetime import datetime

# Directories to scan
dirs_to_scan = [
    '/media/saksham/phone data/programming_projects/upsc_app',
    '/media/saksham/phone data/programming_projects/upsc_app/notes',
    '/media/saksham/80645C95645C9030/saksham/EXAM/01 upsc sociology 2027',
    '/media/saksham/80645C95645C9030/saksham/EXAM'
]

output_dir = '/media/saksham/phone data/programming_projects/upsc_app/notes/UPSC_CSE_2027/00_MASTER_INDEX'
inventory_md = os.path.join(output_dir, 'Resource_Inventory_Detailed.md')
inventory_csv = os.path.join(output_dir, 'Resource_Inventory_Detailed.csv')

file_extensions = {'.pdf', '.txt', '.md', '.doc', '.docx', '.ppt', '.pptx', 
                   '.xls', '.xlsx', '.csv', '.jpg', '.jpeg', '.png', '.gif',
                   '.json', '.py', '.sh'}

files_list = []
file_id = 0

for scan_dir in dirs_to_scan:
    if not os.path.exists(scan_dir):
        continue
    for root, dirs, filenames in os.walk(scan_dir):
        # Skip some dirs
        dirs[:] = [d for d in dirs if d not in ['.git', '__pycache__', '.agent_state']]
        for filename in filenames:
            ext = Path(filename).suffix.lower()
            if ext in file_extensions or filename.startswith('README') or filename.endswith('.md'):
                filepath = os.path.join(root, filename)
                try:
                    size = os.path.getsize(filepath)
                except:
                    size = 0
                file_id += 1
                files_list.append({
                    'file_id': f'FI{file_id:06d}',
                    'filename': filename,
                    'filepath': filepath,
                    'extension': ext,
                    'size_bytes': size,
                    'root_dir': root
                })

# Write CSV
with open(inventory_csv, 'w', newline='', encoding='utf-8') as f:
    writer = csv.DictWriter(f, fieldnames=['file_id', 'filename', 'filepath', 'extension', 'size_bytes', 'root_dir'])
    writer.writeheader()
    for item in files_list:
        writer.writerow(item)

# Write Markdown
with open(inventory_md, 'w', encoding='utf-8') as f:
    f.write('# Detailed Resource Inventory\n\n')
    f.write(f'**Generated:** {datetime.now().strftime("%Y-%m-%d %H:%M:%S")}\n\n')
    f.write(f'**Total Files:** {len(files_list)}\n\n')
    f.write('## Files by Extension\n\n')
    f.write('| Extension | Count |\n|---|---|\n')
    ext_counts = {}
    for item in files_list:
        ext_counts[item['extension']] = ext_counts.get(item['extension'], 0) + 1
    for ext, count in sorted(ext_counts.items(), key=lambda x: x[1], reverse=True):
        f.write(f'| {ext} | {count} |\n')
    f.write('\n## All Files\n\n')
    f.write('| File ID | File Name | Path | Extension | Size (KB) |\n')
    f.write('| --- | --- | --- | --- | --- |\n')
    for item in sorted(files_list, key=lambda x: x['filepath']):
        size_kb = round(item['size_bytes'] / 1024, 2)
        f.write(f'| {item["file_id"]} | {item["filename"]} | {item["filepath"]} | {item["extension"]} | {size_kb} |\n')

print(f'Inventoried {len(files_list)} files')
EOF
